{
  "name": "pegboard-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@pegboard/web",
    "build:web": "npm run build --workspace=@pegboard/web",
    "dev:game": "npm run dev --workspace=@pegboard/game",
    "build:game": "npm run build --workspace=@pegboard/game",
    "test:engine": "npm run test --workspace=@pegboard/engine",
    "typecheck:engine": "npm run typecheck --workspace=@pegboard/engine",
    "test:commentary": "npm run test --workspace=@pegboard/commentary",
    "typecheck:commentary": "npm run typecheck --workspace=@pegboard/commentary"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
